---
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/form/Input.astro";
import Textarea from "@components/ui/form/Textarea.astro";
import Radio from "@components/ui/form/Radio.astro";
import Checkbox from "@components/ui/form/Checkbox.astro";
import Select from "@components/ui/form/Select.astro";

const hearAboutOptions = [
    { label: "Search Engine", value: "search" },
    { label: "Social Media", value: "social" },
    { label: "Friend/Colleague", value: "referral" },
    { label: "Other", value: "other" }
];

const interestOptions = [
    { label: "Web Development", value: "web" },
    { label: "Mobile Development", value: "mobile" },
    { label: "Design Services", value: "design" },
    { label: "Consulting", value: "consulting" }
];

const serviceOptions = [
    { label: "IT Support", value: "it-support" },
    { label: "Network Management", value: "network-management" },
    { label: "Cloud Services", value: "cloud-services" },
    { label: "Consulting", value: "consulting" },
    { label: "Website Design", value: "website-design" }
];

const budgetOptions = [
    { label: "$500 - $2,000", value: "500-2k" },
    { label: "$2,000 - $5,000", value: "2k-5k" },
    { label: "$5,000 - $10,000+", value: "5-10k" },
    { label: "I'm not sure.", value: "unknown" }
];

const formBackground = 'light';
---
<form id="contact-form" class="space-y-6 bg-white p-6 rounded-lg" action="https://docs.google.com/forms/d/e/1FAIpQLScedD6AxX08zGolcHqlqfown1-zGviFPg93t-87bE3kdV0C1w/formResponse" method="POST">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <Input
            label="Name"
            id="name"
            name="entry.1716024320"
            required
            background={formBackground}
        />
        <Input
            label="Email"
            type="email"
            id="email"
            name="entry.1396586034"
            required
            background={formBackground}
        />
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <Input
            label="Phone"
            type="tel"
            id="phone"
            name="entry.1932454173"
            required
            background={formBackground}
        />
        <Input
            label="Company"
            id="company"
            name="entry.1405546991"
            background={formBackground}
            required
        />
    </div>
    
    <Textarea
        label="Message"
        id="message"
        name="entry.1910941364"
        required
        background={formBackground}
    />
    
    <Checkbox
        label="I agree to the terms and conditions of our privacy policy."
        id="terms"
        name="terms"
        required
        background={formBackground}
    />
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <Select
            label="What service are you interested in?"
            id="service"
            name="entry.1485971412"
            options={serviceOptions}
            required
            placeholder="Choose a service"
            background={formBackground}
        />
        <Select
            label="Monthly Budget Range"
            id="budget"
            name="entry.808533374"
            options={budgetOptions}
            required
            placeholder="Select your budget"
            background={formBackground}
        />
    </div>

    <input type="text" name="honeypot" style="display:none;">
    
    <div class="mt-6">
        <Button type="submit" style="background:#d9c479;">Submit</Button>
    </div>

    <div id="form-message" style="display:none;"></div>

</form>