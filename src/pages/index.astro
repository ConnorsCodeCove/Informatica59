---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/sections/Hero.astro';
import SplitPanel from '@components/sections/SplitPanel.astro';
import Features from '@components/sections/Features.astro';
import Stats from '@components/sections/Stats.astro';
import { featureLists } from '@data/features';
import { statsLists } from '@data/stats';
import Logos from '@components/sections/Logos.astro';
import { logoLists } from '@data/logos';
import CtaBanner from '@components/sections/CtaBanner.astro';
import Faqs from '@components/sections/Faqs.astro';
import { faqLists } from '@data/faqs';
import RecentPosts from '@components/sections/RecentPosts.astro';
import heroImage from '../assets/images/home/header1.webp';
import styleGuideImage from '../assets/images/home/cpu.webp';

const seoTitle = "IT Support, Cloud Solutions & Security";
const seoDescription = "Reliable, high-performance IT solutions for Houston businesses, including network security, cloud services, and on-site support.";

const heroContent = {
    title: 'When Every <span class="highlight-byte">Byte</span> Matters.',
    description: 'The complete IT managed service solution for growing businesses. Advanced security, scalable infrastructure, and unmatched support.',
    buttons: [
        {
            text: 'Get Started',
            link: '/contact',
            target: '_self'
        },

    ],
    backgroundImage: heroImage,
    overlayOpacity: 0.99
}

const featuresSection = {
    eyebrow: "",
    title: 'Empower Your <span class="bluegradienttext">Competitive Edge</span>',
    description: 'At our firm, <span class="bluegradienttext">client success is not just a goal; it is our unwavering focus</span>. We do business simply and fairly with no hidden fees or material markups. Elevate your business with a consulting partner that not only understands your needs but goes above and beyond to ensure your success.',
    features: featureLists.main.features,

}

const FooterCta = {
    eyebrow: "Join The Community",
    title: "Let's Connect.",
    description: 'Titan Core is open-source and constantly improving. Join our community of developers to contribute, get support, or showcase what you\'ve built.',
    hideCta: false,
    button: {
        text: 'Get in Touch',
        link: '/contact',
        target: '_blank'
    }
}

const styleGuideSection = {
    eyebrow: "Benefits",
    headline: "From Cloud to On-Site IT Solutions",
    description: "We keep an eye on your IT environment, resolving issues before they become major problems. Affordable and scalable IT services, without the need for in-house expertise. <br><br>Simplify your IT with a single provider and no hidden costs.",
    image: {
        src: styleGuideImage,
        alt: "Featured image"
    },

}

const sideBySideStats = {
    eyebrow: "About",
    title: 'Defining the <span class="bluegradienttext">concierge</span> IT experience',
    description: 'We are a <span class="bluegradienttext">Houston</span>-based, family-owned firm specializing in IT administration for small businesses with a results-driven focus. We have decades of combined experience in consulting and supporting businesses for sustained growth.',
    variant: 'side-by-side' as const,
    stats: statsLists.withContent.stats,
    content: {
        title: 'Defining the <span class="bluegradienttext">concierge</span> IT experience',
        description: 'We are a <span class="bluegradienttext">Houston</span>-based, family-owned firm specializing in IT administration for small businesses with a results-driven focus. We have decades of combined experience in consulting and supporting businesses for sustained growth.',
        button: {
            text: "Let's Connect",
            link: "/contact",
            variant: "gold" as const
        }
    }
};

const mainCta = {
    eyebrow: "",
    title: "Concentrate on your success; we'll take care of the tech.",
    description: 'At <span class="emphasis-glow">Informatica59</span>, we deliver tailored solutions that empower your organization to thrive. We take a concierge-like approach as your Managed Service Provider (MSP). With our support, you can reduce costs and eliminate the need for in-house IT experts, allowing you to concentrate on what matters most—growing your business.',
};


const logosSection = {
    eyebrow: "Our Clients",
    logos: logoLists.main.logos
}

const faqsSection = {
    eyebrow: "FAQs",
    title: 'Frequently Asked Questions',
    description: 'Find answers to common questions about our platform and services.',
    faqs: faqLists.main.faqs
}

const recentPostsSection = {
    eyebrow: "LATEST INSIGHTS",
    title: "Learn From Our Experience",
    description: "Explore our latest articles on IT security best practices, network optimization tips, and cloud solutions to keep your business running smoothly.",
    category: "",
    button: {
            text: "View All Posts",
            link: "/blog",
        variant: "primary" as const
    }
}
---

<Layout footerCta={FooterCta} title={seoTitle} description={seoDescription}>
    <Hero content={heroContent} />
    <CtaBanner content={mainCta} variant="contained" background="light" paddingBottom="base" />
    <SplitPanel content={styleGuideSection} imagePosition="right" background="light" padding="base" />
    <Stats content={sideBySideStats} background='dark' padding="base"/>
    <Features content={featuresSection} padding="base" background="light" />
    <RecentPosts content={recentPostsSection} background="base" padding="base" category={recentPostsSection.category} postsToShow={3}/>
    <Logos content={logosSection} background="base" padding='small'/>
    <Faqs content={faqsSection} background="base" padding="base" />
</Layout>

<script type="module" src="/heroanimation.js" defer></script>
